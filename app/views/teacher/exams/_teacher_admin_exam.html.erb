<% status_label, status_class =
  if exam.cancelled?
    ["Cancelled", "status-cancelled"]
  elsif exam.start_time < Time.current && exam.end_time < Time.current
    ["Missed", "status-missed"]
  elsif exam.active? && exam.approved?
    ["Active", "status-active"]
  elsif exam.approved?
    ["Approved", "status-approved"]
  elsif exam.request_approval?
    ["Requested approval", "status-requested"]
  else
    ["Draft", "status-draft"]
  end %>

<article class="exam-card">
  <div class="exam-card-header">
    <span class="status-pill <%= status_class %>"><%= status_label %></span>
    <h5><%= exam.title %></h5>
  </div>

  <div class="exam-card-body">
    <p class="exam-meta">
      <span>Subject</span>
      <strong><%= exam.subject.presence || "Not specified" %></strong>
      <span>Start time</span>
      <strong><%= exam.start_time.strftime("%Y-%m-%d %H:%M") %></strong>
      <span>End time</span>
      <strong><%= exam.end_time.strftime("%Y-%m-%d %H:%M") %></strong>
    </p>
  </div>

  <div class="exam-card-actions">
    <% unless exam.cancelled? %>
      <%= link_to "Cancel", cancel_teacher_exam_path(exam), class: "btn btn-outline-warning btn-sm", data: { turbo_method: "post" } %>
    <% end %>
    <% if !exam.request_approval && !exam.approved? %>
      <%= link_to "Request Approval", request_approval_teacher_exam_path(exam), class: "btn btn-outline-primary btn-sm", data: { turbo_method: "post" } %>
    <% end %>
    <%= link_to "Delete", teacher_exam_path(exam), class: "btn btn-outline-danger btn-sm", data: { turbo_method: :delete } %>
    <%= link_to "Show Exam", teacher_exam_path(exam), class: "btn btn-primary btn-sm" %>
  </div>
</article>
