<section class="dashboard-header">
  <div>
    <h2><%= @exam.title %></h2>
    <p><%= @exam.description %></p>
  </div>
  <div class="header-actions">
    <%= link_to "Edit Exam", edit_admin_exam_path(@exam), class: "btn btn-outline-primary" %>
    <%= link_to "Back", admin_exams_path, class: "btn btn-outline-secondary" %>
  </div>
</section>

<section class="detail-grid">
  <div class="metric-card">
    <span>Subject</span>
    <strong class="metric-text"><%= @exam.subject.presence || "Not set" %></strong>
  </div>
  <div class="metric-card">
    <span>Start</span>
    <strong class="metric-text"><%= @exam.start_time.strftime("%b %d, %Y %I:%M %p") %></strong>
  </div>
  <div class="metric-card">
    <span>End</span>
    <strong class="metric-text"><%= @exam.end_time.strftime("%b %d, %Y %I:%M %p") %></strong>
  </div>
  <div class="metric-card">
    <span>Status</span>
    <strong class="metric-text"><%= @exam.cancelled? ? "Cancelled" : (@exam.approved? ? "Approved" : "Draft") %></strong>
  </div>
</section>

<section class="panel-card mt-4">
  <div class="panel-title">
    <h3>Questions</h3>
  </div>

  <% if @exam.questions.any? %>
    <div class="question-list">
      <% @exam.questions.each_with_index do |question, index| %>
        <article class="question-row">
          <div>
            <span class="status-pill status-draft">Question <%= index + 1 %></span>
            <h4><%= question.content %></h4>
            <% if question.question_type == "multiple_choice" %>
              <div class="option-list">
                <% question.options.each_key do |option| %>
                  <span><%= option %></span>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="question-actions">
            <%= link_to "Show", admin_exam_question_path(@exam, question), class: "btn btn-outline-primary btn-sm" %>
            <%= button_to "Delete", admin_exam_question_path(@exam, question), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">No questions available.</div>
  <% end %>
</section>
